# 复制为 .env 后按需修改：cp .env.example .env
# 注意：.env 含密钥，已被 .gitignore 忽略，不要提交
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(32))"
WSCHECK_SECRET=change-me-to-a-random-string

# 监听地址与宿主机端口；需要局域网访问时改为 0.0.0.0
WSCHECK_BIND=127.0.0.1
WSCHECK_PORT=8080

# 页面时区
WSCHECK_TZ=Asia/Shanghai

# 单目标目录探测路径上限，0 表示不限制
WSCHECK_DIR_MAX_PATHS=0

# 设为 1 时把爆破、依赖 OOB 的 POC 放回自动扫描
WSCHECK_POC_ALLOW_HEAVY=0
